{
  "name": "framesnpictures/el-visitor",
  "description": "Visitor Package for Laravel",
  "type": "library",
  "require": {
    "php": "^8",
    "framesnpictures/el-helper": "^1",
    "framesnpictures/el-module": "^1",
    "jenssegers/agent": "^2.6",
    "maxmind-db/reader": "~1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10 || ^11",
    "guzzlehttp/guzzle": "^7.9 || ^8.0",
    "laravel/pint": "^1.30",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint"
  },
  "autoload": {
    "psr-4": {
      "FNP\\ElVisitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FNP\\ElVisitor\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Chris Cynarski",
      "email": "chris@cynarski.net"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "FNP\\ElVisitor\\ElVisitorModule"
      ]
    }
  }
}
