{
  "name": "framesnpictures/el-visitor",
  "description": "Visitor Package for Laravel",
  "type": "library",
  "require": {
    "php": "^8",
    "framesnpictures/el-module": "^0",
    "jenssegers/agent": "^2.6",
    "maxmind-db/reader": "~1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^6 || ^7 || ^8 || ^9",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/pint": "^1.24",
    "rector/rector": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "FNP\\ElVisitor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FNP\\ElVisitor\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Chris Cynarski",
      "email": "chris@cynarski.net"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "FNP\\ElVisitor\\ElVisitorModule"
      ]
    }
  }
}
