#!/bin/sh

# Change to the project root directory
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
cd "$SCRIPT_DIR/.."

# Ensure data directory exists and change to it
mkdir -p data
cd data

REPO_URL="https://raw.githubusercontent.com/sapics/ip-location-db/main"

# Download files directly
echo "Downloading dbip-city-ipv4.mmdb..."
curl -L -o dbip-city-ipv4.mmdb "$REPO_URL/dbip-city-mmdb/dbip-city-ipv4.mmdb"

echo "Downloading dbip-city-ipv6.mmdb..."
curl -L -o dbip-city-ipv6.mmdb "$REPO_URL/dbip-city-mmdb/dbip-city-ipv6.mmdb"

echo "Downloading geolite2-city-ipv4.mmdb..."
curl -L -o geolite2-city-ipv4.mmdb "$REPO_URL/geolite2-city-mmdb/geolite2-city-ipv4.mmdb"

echo "Downloading geolite2-city-ipv6.mmdb..."
curl -L -o geolite2-city-ipv6.mmdb "$REPO_URL/geolite2-city-mmdb/geolite2-city-ipv6.mmdb"

echo "Downloading asn-ipv4.mmdb..."
curl -L -o asn-ipv4.mmdb "$REPO_URL/asn-mmdb/asn-ipv4.mmdb"

echo "Downloading asn-ipv6.mmdb..."
curl -L -o asn-ipv6.mmdb "$REPO_URL/asn-mmdb/asn-ipv6.mmdb"